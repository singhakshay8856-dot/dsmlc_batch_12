Class task of slicing.

my_lst = [10,20,30,40,50,60]
Qno1. result should be [20,30,40]
Qno2. result should be [10,20,30]
Qno3. result should be [40,50,60]
Qno4. result should be [10,30,50]
Qno5. result should be [60,50,40,30,20,10]
Qno6. result should be [10,20,30,40,50,60]

my_lst = [10,20,30,40,50,60]
my_lst[1:4]
#[20,30,40]

my_lst = [10,20,30,40,50,60]
my_lst[:3]
#[10,20,30]

my_lst = [10,20,30,40,50,60]
my_lst[3:]
#[40,50,60]

my_lst = [10,20,30,40,50,60]
my_lst[0:60:2]
#[10,30,50]

my_lst = [10,20,30,40,50,60]
my_lst[::-1]
#[60,50,40,30,20,10]

my_lst = [10,20,30,40,50,60]
my_lst[::]
#[10,20,30,40,50,60]
